{
  "name": "kart-cup-2026",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate-data && astro check && eslint .",
    "test:e2e": "astro build && playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:fixture": "KARTCUP_FIXTURE=1 astro build && KARTCUP_FIXTURE=1 playwright test",
    "add-result": "tsx scripts/add-result.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "lhci": "astro build && lhci autorun",
    "og-image": "python3 scripts/generate-og-image.py"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/tailwind": "5.1.5",
    "astro": "4.16.19",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.2.1",
    "@axe-core/playwright": "4.10.1",
    "@clack/prompts": "0.9.1",
    "@eslint/js": "9.39.1",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.57.0",
    "@types/node": "18.19.68",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.3.1",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.19.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.9"
  },
  "overrides": {
    "@astrojs/language-server": "2.15.4"
  }
}
