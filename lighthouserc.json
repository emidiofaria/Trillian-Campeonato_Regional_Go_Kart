{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4400",
      "startServerReadyPattern": "localhost:4400",
      "url": [
        "http://localhost:4400/Trillian-Campeonato_Regional_Go_Kart/",
        "http://localhost:4400/Trillian-Campeonato_Regional_Go_Kart/404.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.95
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$).*",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
