---
import type { BadgeVariant } from '../types';

interface Props {
  variant?: BadgeVariant;
  class?: string;
}

const { variant = 'neutral', class: className = '' } = Astro.props;

const variants: Record<BadgeVariant, string> = {
  neutral: 'border-border-strong bg-elevated text-fg-muted',
  yellow: 'border-brand-yellow/50 bg-brand-yellow/10 text-brand-yellow',
  green: 'border-brand-green-text/50 bg-brand-green/15 text-brand-green-text',
  blue: 'border-brand-blue-text/50 bg-brand-blue/40 text-brand-blue-text',
  ring: 'border-brand-ring/50 bg-brand-ring/10 text-brand-ring',
  danger: 'border-rose-400/50 bg-rose-500/10 text-rose-300',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
