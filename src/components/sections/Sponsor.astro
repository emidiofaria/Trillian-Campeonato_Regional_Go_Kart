---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../icons/Icon.astro';
import { SPONSOR, withBase } from '../../lib/site';
---

<Section id="patrocinador" eyebrow="Patrocinador Oficial" title="Trillian Driving Coach">
  <span slot="title-icon" class="mr-2 inline-block align-[-0.1em] text-brand-yellow">
    <Icon name="star" size={30} />
  </span>

  <div
    class="flex flex-col items-center gap-8 rounded-2xl border border-border bg-surface p-6 text-center sm:p-8 md:flex-row md:text-left"
  >
    <img
      src={withBase('trillian-logo-192.png')}
      alt="Logótipo da Trillian Driving Coach"
      width="192"
      height="192"
      loading="lazy"
      decoding="async"
      class="h-32 w-32 shrink-0 rounded-full sm:h-40 sm:w-40"
    />
    <div>
      <p class="max-w-2xl text-lg leading-relaxed text-fg-muted">
        A Trillian Driving Coach é a app que acompanha a Kart Cup 2026. Regista as tuas sessões,
        compara voltas e recebe dicas para seres mais rápido e consistente em cada kartódromo do
        campeonato.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3 md:justify-start">
        <Button
          href={SPONSOR.playStoreUrl}
          variant="green"
          external
          aria-label="Obter no Google Play: app Trillian Driving Coach (abre num novo separador)"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path d="M4 3.5v17a1 1 0 0 0 1.5.86L20 13a1.15 1.15 0 0 0 0-2L5.5 2.64A1 1 0 0 0 4 3.5Z"
            ></path>
          </svg>
          Obter no Google Play
        </Button>
        <Button
          href={SPONSOR.websiteUrl}
          variant="secondary"
          external
          aria-label="Visitar Website da Trillian Driving Coach (abre num novo separador)"
        >
          Visitar Website
        </Button>
      </div>
    </div>
  </div>
</Section>
