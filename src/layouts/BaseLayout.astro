---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kart Cup 2026',
  description = 'Site oficial da Kart Cup 2026, campeonato de karting de aluguer entre amigos.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}trillian-logo-32.png`} />
    <link rel="apple-touch-icon" href={`${base}trillian-logo-180.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
  </head>
  <body class="bg-[#0d1117] text-slate-100">
    <slot />
  </body>
</html>
