---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = `${SITE_NAME} — Campeonato de Karting`,
  description = 'Site oficial da Kart Cup 2026: classificação, calendário, pilotos e regulamento do campeonato de karting de aluguer entre amigos, com o apoio da Trillian Driving Coach.',
  ogImage = 'og-image.png',
  noindex = false,
} = Astro.props;
const ogImageAlt = 'Kart Cup 2026 — campeonato de karting com o apoio da Trillian Driving Coach';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(withBase(ogImage), Astro.site);

const fonts = {
  inter: withBase('fonts/inter-latin-wght-normal.woff2'),
  barlow600: withBase('fonts/barlow-condensed-latin-600-normal.woff2'),
  barlow700: withBase('fonts/barlow-condensed-latin-700-normal.woff2'),
};

const fontFaces = `
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url('${fonts.inter}') format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:'Barlow Condensed';font-style:normal;font-display:swap;font-weight:600;src:url('${fonts.barlow600}') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:'Barlow Condensed';font-style:normal;font-display:swap;font-weight:700;src:url('${fonts.barlow700}') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
`;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={fonts.inter} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fonts.barlow700} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('trillian-logo-32.png')} />
    <link rel="apple-touch-icon" href={withBase('trillian-logo-180.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg">
    <a href="#conteudo" class="skip-link">Saltar para o conteúdo</a>
    <Navbar />
    <main id="conteudo" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
